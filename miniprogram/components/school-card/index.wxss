.school { margin-bottom: 20rpx; padding: 28rpx; background: #fff; border: 1rpx solid #e9ece3; border-radius: 24rpx; }.top { display: flex; align-items: center; }.badge { background: #eef1e6; color: #506347; width: 78rpx; height: 78rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; font-size: 34rpx; font-family: serif; font-weight: bold; flex-shrink: 0; }.info { flex: 1; min-width: 0; margin-left: 22rpx; }.name { color: #283f30; font-size: 30rpx; font-weight: 600; }.meta { color: #8c9287; font-size: 22rpx; margin-top: 8rpx; }.level { margin-left: 16rpx; background: #f3f4ed; color: #667b53; padding: 3rpx 10rpx; border-radius: 6rpx; }.arrow { color: #7d8a70; font-size: 32rpx; margin-left: 12rpx; }.description { color: #899083; font-size: 24rpx; line-height: 1.7; margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid #f0f2eb; }
