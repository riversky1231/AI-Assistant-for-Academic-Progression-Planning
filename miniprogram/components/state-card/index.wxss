.state { text-align: center; padding: 62rpx 30rpx; background: #fff; border: 1rpx solid #e9ece3; border-radius: 24rpx; }.symbol { color: #8b9e7c; font-size: 42rpx; margin: 0 auto 20rpx; }.heading { color: #344b3b; font-size: 29rpx; font-weight: 600; }.description { margin-top: 14rpx; color: #899083; font-size: 24rpx; line-height: 1.8; }button { background: #edf1e8; color: #34553d; font-size: 25rpx; display: inline-block; margin-top: 28rpx; padding: 0 40rpx; border-radius: 14rpx; }button::after { border: 0; }.spinner { width: 36rpx; height: 36rpx; border: 4rpx solid #e9eee1; border-top-color: #426349; border-radius: 50%; animation: spin 1s linear infinite; }@keyframes spin { to { transform: rotate(360deg); } }
