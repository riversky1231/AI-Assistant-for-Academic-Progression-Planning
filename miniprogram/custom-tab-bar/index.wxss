.tabbar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 20; display: flex; background: #fff; border-top: 1rpx solid #e9ece3; padding: 18rpx 16rpx calc(14rpx + env(safe-area-inset-bottom)); }
.tab { flex: 1; background: transparent; border-radius: 0; padding: 0; margin: 0; color: #91978d; font-size: 21rpx; line-height: 1.7; display: flex; flex-direction: column; align-items: center; font-weight: 400; }
.tab::after { border: 0; }.active { color: #244c3b; font-weight: 600; }.icon { position: relative; width: 32rpx; height: 32rpx; margin: 4rpx 0 12rpx; box-sizing: border-box; }.dot { width: 7rpx; height: 7rpx; border-radius: 50%; background: #244c3b; position: absolute; bottom: -9rpx; }
.home { border: 3rpx solid currentColor; border-top: 0; width: 29rpx; height: 24rpx; margin-top: 12rpx; }.home::before { content: ''; width: 22rpx; height: 22rpx; border-left: 3rpx solid currentColor; border-top: 3rpx solid currentColor; position: absolute; transform: rotate(45deg); top: -14rpx; left: 0; }.home .part { width: 7rpx; height: 12rpx; border: 2rpx solid currentColor; border-bottom: 0; position: absolute; bottom: 0; left: 8rpx; }
.school { border: 3rpx solid currentColor; border-radius: 2rpx; }.school::before,.school::after { content: ''; position: absolute; top: 5rpx; bottom: 5rpx; border-left: 3rpx solid currentColor; }.school::before { left: 7rpx; }.school::after { right: 7rpx; }
.plan { border: 3rpx solid currentColor; border-radius: 5rpx; }.plan::before,.plan::after { content: ''; position: absolute; left: 5rpx; right: 5rpx; border-top: 3rpx solid currentColor; }.plan::before { top: 7rpx; }.plan::after { top: 17rpx; }
.user::before { content: ''; position: absolute; width: 12rpx; height: 12rpx; border: 3rpx solid currentColor; border-radius: 50%; top: -2rpx; left: 7rpx; }.user::after { content: ''; position: absolute; bottom: -2rpx; width: 28rpx; height: 13rpx; border: 3rpx solid currentColor; border-radius: 18rpx 18rpx 4rpx 4rpx; }
