.chat-page { position: fixed; top: 0; right: 0; left: 0; display: flex; flex-direction: column; background: #f7f8f2; }
.chat-header { flex: none; display: flex; align-items: center; justify-content: space-between; padding: 24rpx 30rpx; border-bottom: 1rpx solid #e5eadd; background: #f7f8f2; gap: 12rpx; }
.advisor { display: flex; align-items: center; gap: 16rpx; min-width: 0; }.advisor-mark { display: block; width: 68rpx; height: 68rpx; border-radius: 22rpx; background: #244c3b; flex: none; }
.advisor-name { font-size: 27rpx; font-weight: 600; }.ai-tag { font-size: 17rpx; color: #718060; border: 1rpx solid #d3ddc5; padding: 2rpx 7rpx; border-radius: 5rpx; margin-left: 6rpx; }.advisor-note { color: #89927f; font-size: 21rpx; margin-top: 4rpx; }
.new-chat { flex: none; background: #eaf0e1; color: #42603d; padding: 0 18rpx; line-height: 62rpx; border-radius: 14rpx; font-size: 22rpx; font-weight: 500; }
.conversation { flex: 1; height: 0; min-height: 0; }.conversation-inner { padding: 0 30rpx; }.welcome-panel { padding: 30rpx 6rpx 12rpx; }.welcome-art { width: 138rpx; height: 130rpx; position: relative; margin: 0 auto 28rpx; }.art-orbit { position: absolute; width: 132rpx; height: 85rpx; border: 1rpx solid #c3d0af; border-radius: 50%; transform: rotate(-40deg); top: 20rpx; }.art-orbit-two { transform: rotate(40deg); }.art-spark { position: absolute; left: 43rpx; top: 14rpx; font-size: 69rpx; color: #4e7050; }.art-dot { position: absolute; top: 36rpx; right: -3rpx; color: #a0ad64; font-size: 56rpx; }
.welcome-panel .eyebrow { text-align: center; font-size: 17rpx; letter-spacing: 2rpx; }.welcome-title { text-align: center; font-size: 46rpx; font-weight: 600; line-height: 1.45; margin-top: 18rpx; }.welcome-description { text-align: center; color: #85907c; font-size: 23rpx; line-height: 1.85; margin: 18rpx 0 32rpx; }.topic-label { font-size: 21rpx; color: #929b89; margin-bottom: 14rpx; }.topic { display: flex; align-items: center; gap: 20rpx; text-align: left; padding: 22rpx; background: #fff; border: 1rpx solid #e5eadc; border-radius: 20rpx; margin-top: 14rpx; line-height: 1.5; font-weight: 400; color: #344c3b; }.topic-icon { width: 52rpx; height: 52rpx; border-radius: 15rpx; text-align: center; line-height: 52rpx; background: #f0f3e8; color: #72885d; font-size: 32rpx; flex: none; }.topic-copy { flex: 1; min-width: 0; }.topic-title { font-size: 26rpx; font-weight: 550; }.topic-detail { font-size: 21rpx; color: #919886; margin-top: 6rpx; }.topic-arrow { color: #8b9b77; }.scope-note { font-size: 20rpx; color: #969e8e; line-height: 1.8; margin-top: 24rpx; }
.history-note { color: #9ca590; font-size: 20rpx; text-align: center; padding: 26rpx 0 0; }.message { margin-top: 32rpx; }.message-label { display: flex; align-items: center; gap: 9rpx; font-size: 22rpx; color: #819071; margin-bottom: 12rpx; }.message-avatar { display: block; width: 52rpx; height: 52rpx; border-radius: 16rpx; background: #244c3b; flex: none; }.bubble { border-radius: 8rpx 24rpx 24rpx; background: #fff; border: 1rpx solid #e8ecdf; padding: 26rpx; }.message-user { display: flex; justify-content: flex-end; margin-left: 50rpx; }.message-user .bubble { background: #294e3c; color: #f8faef; border-color: #294e3c; border-radius: 24rpx 8rpx 24rpx 24rpx; }.user-text { white-space: pre-wrap; word-break: break-word; font-size: 28rpx; line-height: 1.85; }
.answer-actions { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #edf0e7; }.source-link, .copy-button { background: transparent; font-size: 21rpx; padding: 0; line-height: 2; font-weight: 400; color: #56704c; }.copy-button { flex: none; color: #8a9581; }.no-sources { font-size: 20rpx; color: #99a08f; }.thinking { display: flex; align-items: center; gap: 20rpx; margin: 32rpx 0; font-size: 25rpx; color: #55714b; }.thinking .muted { font-size: 21rpx; margin-top: 4rpx; }.thinking-dots { display: flex; gap: 6rpx; }.thinking-dots text { width: 9rpx; height: 9rpx; border-radius: 50%; background: #8ea378; animation: pulse 1.5s ease-in-out infinite; }.thinking-dots text:nth-child(2) { animation-delay: .2s; }.thinking-dots text:nth-child(3) { animation-delay: .4s; }@keyframes pulse { 0%, 100% { opacity: .3; } 50% { opacity: 1; } }.scroll-space { height: 32rpx; }
.composer { flex: none; background: #fff; border-top: 1rpx solid #e7ecdf; padding: 18rpx 28rpx 16rpx; }.composer.keyboard-open { padding-bottom: 12rpx; }.composer-tools { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }.profile-chip { color: #668151; background: #f1f5e9; font-size: 21rpx; font-weight: 400; padding: 0 16rpx; line-height: 48rpx; border-radius: 12rpx; }.character-count { font-size: 20rpx; color: #a0a694; }.input-shell { background: #f6f7f1; border: 1rpx solid #e7ebdf; border-radius: 22rpx; padding: 18rpx 16rpx 18rpx 20rpx; display: flex; align-items: flex-end; gap: 14rpx; }.chat-input { flex: 1; width: 0; height: 88rpx; min-height: 88rpx; padding: 0; font-size: 26rpx; line-height: 1.65; color: #34483b; }.input-placeholder { color: #a0a894; }.send-button { flex: none; width: 64rpx; height: 64rpx; line-height: 60rpx; padding: 0; border-radius: 18rpx; font-size: 38rpx; background: #244c3b; color: #eef5d2; }.composer-note { text-align: center; color: #a0a694; font-size: 18rpx; margin-top: 12rpx; }.chat-error { color: #9d6248; background: #faf1e7; border-radius: 14rpx; padding: 16rpx 20rpx; font-size: 23rpx; margin-bottom: 16rpx; }.chat-error .text-button { font-size: 22rpx; text-align: left; margin-top: 8rpx; }
