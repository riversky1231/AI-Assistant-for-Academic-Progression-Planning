.consult-entry { display: flex; align-items: center; gap: 22rpx; padding: 28rpx; border-radius: 24rpx; background: #eff2e5; border: 1rpx solid #dee5cf; text-align: left; line-height: 1.6; font-weight: 400; color: #365337; }.consult-symbol { flex: none; font-size: 52rpx; color: #7b915c; }.consult-copy { flex: 1; min-width: 0; }.consult-kicker { font-size: 19rpx; color: #83936c; letter-spacing: 2rpx; }.consult-title { font-size: 29rpx; font-weight: 600; margin: 7rpx 0; }.consult-description { font-size: 21rpx; color: #8a967c; }.consult-arrow { font-size: 30rpx; color: #819668; }
.welcome { margin: 4rpx 0 28rpx; }.brand-dot { font-size: 21rpx; color: #77846d; }.brand-dot::before { content: ''; display: inline-block; width: 9rpx; height: 9rpx; border-radius: 50%; background: #859965; margin-right: 10rpx; }
.hero { background: #254d3d; border-radius: 30rpx; color: #fff; padding: 36rpx 34rpx 28rpx; position: relative; overflow: hidden; }.hero-tag { color: #d4dfb7; font-size: 22rpx; letter-spacing: 3rpx; position: relative; z-index: 1; }.hero-title { font-size: 51rpx; font-weight: 600; line-height: 1.5; letter-spacing: 1rpx; margin-top: 28rpx; position: relative; z-index: 1; }.hero-description { font-size: 23rpx; color: #c0cfc2; margin-top: 16rpx; position: relative; z-index: 1; }.hero-button { display: flex; justify-content: space-between; background: #e5edbd; color: #2f4933; font-size: 25rpx; padding: 0 28rpx; width: 366rpx; line-height: 78rpx; margin: 34rpx 0 38rpx; position: relative; z-index: 1; border-radius: 14rpx; }.hero-bottom { display: flex; align-items: center; font-size: 16rpx; letter-spacing: 3rpx; color: #a6bfa9; }.hero-line { height: 1rpx; background: #648370; flex: 1; margin: 0 20rpx; }.orbit { position: absolute; width: 340rpx; height: 340rpx; border: 1rpx solid #668769; border-radius: 50%; opacity: .45; right: -170rpx; top: 15rpx; }.orbit-two { right: -110rpx; top: 80rpx; }.star { position: absolute; right: 40rpx; top: 175rpx; font-size: 82rpx; color: #b3c293; opacity: .6; }
.profile-strip { display: flex; align-items: center; padding: 26rpx 0; border-bottom: 1rpx solid #e4e8dc; }.profile-icon { color: #647853; background: #e9eedd; border-radius: 12rpx; width: 62rpx; height: 66rpx; text-align: center; line-height: 66rpx; font-size: 26rpx; }.profile-copy { flex: 1; margin: 0 18rpx; }.strip-title { font-size: 27rpx; font-weight: 600; margin-bottom: 5rpx; }.profile-copy .muted { font-size: 21rpx; }.entry-grid { display: flex; gap: 20rpx; }.entry { flex: 1; min-width: 0; padding: 25rpx; border-radius: 23rpx; }.entry-green { background: #e9eedf; }.entry-cream { background: #f1eada; }.entry-top { display: flex; justify-content: space-between; color: #677754; }.entry-icon { font-size: 45rpx; line-height: 1; }.entry-title { font-size: 29rpx; font-weight: 600; margin-top: 30rpx; }.entry-desc { color: #878a73; font-size: 20rpx; margin-top: 8rpx; }
