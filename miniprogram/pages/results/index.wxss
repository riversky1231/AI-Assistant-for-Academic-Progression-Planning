.heading { font-size: 43rpx; margin: 18rpx 0 28rpx; }.summary { background: #eaf0e2; border-color: #e0e7d5; }.summary-title { font-size: 27rpx; font-weight: 600; }.scores { display: flex; gap: 50rpx; color: #7b896e; font-size: 25rpx; margin-top: 20rpx; }.scores text { color: #36553b; font-size: 49rpx; font-weight: 600; }.preferences { font-size: 24rpx; color: #687d5b; margin-top: 10rpx; }.generated { font-size: 21rpx; color: #87947c; margin-top: 18rpx; }.group-tabs { display: flex; gap: 16rpx; margin-bottom: 25rpx; }.group-tab { flex: 1; display: flex; align-items: center; justify-content: center; gap: 15rpx; padding: 0 12rpx; background: #efF1e9; color: #89917f; font-size: 27rpx; line-height: 88rpx; border-radius: 16rpx; border: 1rpx solid transparent; }.group-tab.selected { border-color: currentColor; }.count { font-size: 23rpx; opacity: .8; }.result-card { margin-bottom: 24rpx; }.result-school { flex: 1; min-width: 0; }.school-copy { margin-left: 18rpx; flex: 1; min-width: 0; }.school-name { font-size: 29rpx; font-weight: 600; }.school-copy .muted { font-size: 21rpx; margin-top: 8rpx; }.category-tag { padding: 5rpx 14rpx; border-radius: 9rpx; font-size: 24rpx; margin-left: 12rpx; }.major { font-size: 27rpx; margin-top: 26rpx; padding-top: 23rpx; border-top: 1rpx solid #ecf0e5; font-weight: 500; }.result-metrics { display: flex; margin: 22rpx 0; }.result-metrics > view { flex: 1; }.result-metrics text { font-size: 32rpx; font-weight: 600; color: #4f6849; }.result-metrics view view { font-size: 20rpx; color: #929a87; margin-top: 5rpx; }.reason { font-size: 23rpx; color: #8a8f7c; background: #f7f8f2; padding: 18rpx 20rpx; border-radius: 12rpx; line-height: 1.8; }.detail-link { margin: 22rpx 0 0 auto; }
