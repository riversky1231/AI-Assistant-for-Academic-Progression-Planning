<view class="page sources-page">
  <state-card wx:if="{{!available}}" title="这段咨询已不在本机保留" description="开启新咨询、退出账号或重启小程序后，请重新咨询以获取依据。" action="返回智能咨询" bindretry="chat" />
  <block wx:else>
    <view class="eyebrow">BEHIND THE ANSWER</view><view class="title source-heading">每个建议，<view>都有迹可循。</view></view>
    <view class="subtitle">把分析和依据放在一起，做更清楚的选择。</view>
    <view class="source-overview"><view><text class="overview-number">{{count}}</text><text>项本轮依据</text></view><view class="overview-divider"></view><view><text class="overview-number">{{referenceCount}}</text><text>项背景参考</text></view></view>
    <view class="notice">以下是本轮实际查询或读取的结果。历史录取数据与背景资料都不代表当年招生政策，请以官方发布为准。</view>
    <state-card wx:if="{{!sources.length}}" title="本轮没有引用查询数据" description="这可能是一轮信息确认或方向讨论。需要具体院校建议时，可以继续补充省份、科类和位次。" />
    <view wx:for="{{sources}}" wx:key="key" wx:for-item="source" wx:for-index="sourceIndex" class="source-section">
      <view class="source-section-head"><text class="source-number">{{source.number}}</text><view class="source-heading-copy"><view class="source-title">{{source.title}}</view><text class="source-label {{source.kind === 'reference' ? 'reference-label' : ''}}">{{source.label}}</text></view></view>
      <block wx:if="{{source.kind === 'schools'}}">
        <school-card wx:for="{{source.schools}}" wx:key="id" school="{{item}}" />
        <view wx:if="{{!source.schools.length}}" class="empty-source card">本次查询没有匹配院校，可以调整关键词或地区。</view>
      </block>
      <block wx:elif="{{source.kind === 'detail'}}">
        <school-card school="{{source.school}}" />
        <view wx:if="{{source.admissions.length}}" class="card admission-list"><view class="table-caption">历史录取记录 · {{source.admissions.length}} 条</view><view wx:for="{{source.admissions}}" wx:key="key" class="admission-row"><view class="admission-title">{{item.major.name || '专业信息未提供'}}</view><view class="muted">{{item.province}} · {{item.subject_type}} · {{item.year}} 年</view><view class="admission-values"><text>最低分 <text class="value">{{item.scoreText}}</text></text><text>最低位次 <text class="value">{{item.rankText}}</text></text></view></view></view>
        <view wx:else class="empty-source card">暂无历史录取记录，不代表该校不招生。</view>
      </block>
      <block wx:elif="{{source.kind === 'recommend'}}">
        <view wx:if="{{source.message}}" class="source-message">{{source.message}}</view>
        <view wx:for="{{source.groups}}" wx:key="name" wx:for-item="group" class="recommend-group">
          <view class="group-head"><text class="group-tag {{group.tone}}">{{group.title}}</text><text class="muted">{{group.items.length}} 条专业推荐</text></view>
          <view wx:if="{{!group.items.length}}" class="group-empty">本组暂无匹配数据</view>
          <view wx:for="{{group.items}}" wx:key="key" class="card recommendation">
            <button class="school-link" bindtap="detail" data-id="{{item.school.id}}"><text>{{item.school.name}}</text><text>↗</text></button>
            <view class="recommend-major">{{item.major.name}}</view>
            <view class="recommend-values"><view><text>{{item.major.min_score === null ? '—' : item.major.min_score}}</text><view>历史最低分</view></view><view><text>{{item.rankText}}</text><view>历史最低位次</view></view><view><text>{{item.gapText}}</text><view>位次差</view></view></view>
            <view class="recommend-reason">{{item.reason}}</view>
          </view>
        </view>
        <view class="notice">{{source.disclaimer}}</view>
      </block>
      <view wx:elif="{{source.kind === 'reference'}}" class="card reference-card"><view class="reference-intro">用于理解分析框架的背景资料，其中的数字、政策或观点不应当作当前事实。</view><button class="reference-toggle" bindtap="toggle" data-index="{{sourceIndex}}">{{source.open ? '收起资料原文 −' : '展开资料原文 ＋'}}</button><view wx:if="{{source.open}}" class="reference-content"><answer-text content="{{source.content || '暂无资料正文'}}" /></view></view>
      <view wx:else class="empty-source card">该依据暂不支持展示，你可以继续追问具体的数据来源。</view>
    </view>
    <button class="secondary section" bindtap="chat">回到咨询，继续聊聊</button>
    <view class="footnote">依据仅对应本轮回答，后续查询结果可能不同。</view>
  </block>
</view>
