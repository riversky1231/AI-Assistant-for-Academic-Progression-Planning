.school-hero { background: #eaf0e1; border: 1rpx solid #dee7d1; border-radius: 28rpx; padding: 36rpx; }.large { width: 100rpx; height: 100rpx; background: #fff; font-size: 46rpx; }.school-hero .eyebrow { font-size: 17rpx; letter-spacing: 2rpx; }.school-name { font-size: 43rpx; font-weight: 650; margin-top: 28rpx; }.location { color: #758169; font-size: 25rpx; margin-top: 12rpx; }.location .tag { margin-left: 22rpx; background: #dce6ce; }.school-description { color: #6e7c61; font-size: 26rpx; line-height: 1.9; margin-top: 28rpx; border-top: 1rpx solid #d9e3cc; padding-top: 24rpx; }.filter-row { display: flex; gap: 12rpx; margin-bottom: 24rpx; }.filter-row picker { flex: 1; min-width: 0; }.filter-row picker view { text-align: center; background: #edf1e6; padding: 15rpx 8rpx; border-radius: 12rpx; font-size: 23rpx; color: #617452; }.admission { margin-bottom: 22rpx; }.major-name { font-size: 30rpx; font-weight: 600; }.admission-meta { font-size: 23rpx; color: #8b9481; margin-top: 10rpx; }.category { color: #738064; margin-left: 20rpx; }.metrics { display: flex; padding: 24rpx 0; margin-top: 14rpx; background: #f8f9f4; border-radius: 14rpx; }.metrics view { flex: 1; padding-left: 30rpx; }.metrics view + view { border-left: 1rpx solid #e4e9dc; }.metric-number { display: block; color: #365538; font-size: 43rpx; font-weight: 600; line-height: 1.3; }.metric-label { display: block; color: #929887; font-size: 22rpx; margin-top: 8rpx; }.major-description { color: #858e7b; font-size: 24rpx; margin-top: 22rpx; }
