<view class="page tab-page">
  <view class="eyebrow">FIND YOUR UNIVERSITY</view><view class="title heading"><view>总有一所大学，</view><view>与你的热爱相遇。</view></view>
  <view class="search">
    <text class="search-symbol">⌕</text>
    <input class="search-input" value="{{keyword}}" bindinput="input" bindconfirm="load" maxlength="50" confirm-type="search" placeholder="搜索院校名称或关键词" placeholder-class="placeholder" />
  </view>
  <button class="search-button" bindtap="load">搜索</button>
  <view class="between filters"><picker range="{{provinces}}" value="{{provinceIndex}}" bindchange="province"><view class="filter">{{provinces[provinceIndex]}} <text>⌄</text></view></picker><text class="muted">按院校所在地筛选</text></view>
  <view class="section-head list-heading"><text class="section-title">院校一览</text><text class="muted" wx:if="{{loggedIn && !loading && !error}}">本次展示 {{schools.length}} 所</text></view>
  <state-card wx:if="{{!loggedIn}}" title="登录，发现更多可能" description="院校与录取信息需要登录后查看" action="去登录" bindretry="login" />
  <state-card wx:elif="{{loading}}" loading />
  <state-card wx:elif="{{error}}" title="院校加载失败" description="{{error}}" action="重试" bindretry="load" />
  <state-card wx:elif="{{!schools.length}}" title="暂无匹配院校" description="换个关键词，或试试其他地区" action="重置筛选" bindretry="clear" />
  <block wx:else><school-card wx:for="{{schools}}" wx:key="id" school="{{item}}" /><view class="footnote">{{schools.length === 50 ? '最多展示 50 所，请通过关键词和地区缩小范围' : '已展示本次查询的全部院校'}}</view></block>
</view>
