.heading { margin: 18rpx 0 34rpx; font-size: 43rpx; line-height: 1.5; }
.search {
  display: flex;
  align-items: center;
  height: 84rpx;
  padding: 8rpx 20rpx;
  background: #fff;
  border: 1rpx solid #e4e9dd;
  border-radius: 18rpx;
}
.search-symbol {
  flex: none;
  width: 32rpx;
  margin-right: 12rpx;
  color: #778b69;
  font-size: 32rpx;
  line-height: 1;
}
.search-input {
  flex: 1;
  width: 0;
  min-width: 0;
  height: 64rpx;
  padding: 0;
  font-size: 26rpx;
  line-height: 64rpx;
}
.search-button {
  display: block;
  width: 100%;
  height: 72rpx;
  margin: 16rpx 0 0;
  padding: 0;
  background: #eaf0e2;
  color: #46613a;
  font-size: 26rpx;
  line-height: 72rpx;
  border-radius: 12rpx;
}
.filters { margin-top: 22rpx; }.filter { background: #eaf0e2; color: #4a6441; padding: 12rpx 22rpx; border-radius: 12rpx; font-size: 25rpx; }.filter text { margin-left: 22rpx; }.list-heading { margin-top: 38rpx; }
