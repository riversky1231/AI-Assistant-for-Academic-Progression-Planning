.forgot-page { padding: 48rpx 36rpx 58rpx; }
.login-brand { display: flex; align-items: center; gap: 22rpx; margin-bottom: 42rpx; }
.logo { width: 100rpx; height: 100rpx; background: #244c3b; border-radius: 28rpx; color: #e6edc8; font-family: serif; font-size: 54rpx; display: flex; align-items: center; justify-content: center; position: relative; box-shadow: 0 16rpx 28rpx rgba(36, 76, 59, .14); }
.logo-star { position: absolute; right: -14rpx; top: -22rpx; color: #b6bd8b; font-size: 44rpx; }
.brand-caption { color: #6f806b; font-size: 24rpx; letter-spacing: 2rpx; }
.forgot-page > .eyebrow, .forgot-page > .title, .forgot-page > .subtitle { display: block; text-align: center; }
.title { margin-top: 18rpx; font-size: 48rpx; letter-spacing: -1rpx; }
.recovery-form { margin-top: 40rpx; padding: 30rpx; box-shadow: 0 14rpx 34rpx rgba(40, 65, 48, .05); }
.field { margin-top: 24rpx; }.label { color: #385342; }.input { width: 100%; }
.compact-field { margin-top: 0; }.or-divider { display: flex; align-items: center; gap: 16rpx; color: #9aa294; font-size: 22rpx; margin-top: 24rpx; }.or-divider::before, .or-divider::after { content: ''; height: 1rpx; background: #e9ece3; flex: 1; }
.password-wrap { position: relative; }.password-wrap .input { padding-right: 105rpx; }
.eye-toggle { position: absolute; top: 15rpx; right: 14rpx; width: 82rpx; height: 60rpx; display: flex; align-items: center; justify-content: center; background: transparent; padding: 0; }
.eye-icon { width: 38rpx; height: 24rpx; border: 3rpx solid #6c7d63; border-radius: 80% 20%; transform: rotate(45deg); display: flex; align-items: center; justify-content: center; }.eye-pupil { width: 9rpx; height: 9rpx; border-radius: 50%; background: #6c7d63; transform: rotate(-45deg); }.eye-icon.is-visible { border-color: #244c3b; }.eye-icon.is-visible .eye-pupil { background: #244c3b; }
.submit { width: 100%; margin-top: 32rpx; text-align: center; box-shadow: 0 10rpx 18rpx rgba(36, 76, 59, .12); }.back-link { width: 100%; margin-top: 16rpx; background: transparent; color: #6c7d63; font-size: 24rpx; text-align: center; }.back-link::after { border: 0; }.footnote { margin-top: 38rpx; }
