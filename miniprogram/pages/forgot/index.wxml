<view class="page forgot-page">
  <view class="login-brand"><view class="logo">远<view class="logo-star">✦</view></view><view class="brand-caption">向远 · 升学规划</view></view>
  <text class="eyebrow">ACCOUNT RECOVERY</text>
  <view class="title">找回密码</view>
  <view class="subtitle">验证绑定信息，重新设置登录密码</view>
  <view class="card recovery-form">
    <view class="field"><text class="label">账号</text><input class="input" value="{{username}}" data-field="username" bindinput="input" maxlength="50" placeholder="请输入账号" placeholder-class="placeholder" disabled="{{busy}}" /></view>
    <view class="field"><text class="label">手机号</text><input class="input" value="{{phone}}" data-field="phone" bindinput="input" maxlength="11" type="number" placeholder="请输入绑定手机号" placeholder-class="placeholder" disabled="{{busy}}" /></view>
    <view class="or-divider"><text>或使用绑定邮箱</text></view>
    <view class="field compact-field"><text class="label">邮箱</text><input class="input" value="{{email}}" data-field="email" bindinput="input" maxlength="100" placeholder="请输入绑定邮箱" placeholder-class="placeholder" disabled="{{busy}}" /></view>
    <view class="field"><text class="label">新密码</text><view class="password-wrap"><input class="input" value="{{newPassword}}" data-field="newPassword" bindinput="input" password="{{!visible}}" maxlength="100" placeholder="请输入 8–100 位新密码" placeholder-class="placeholder" disabled="{{busy}}" /><button class="eye-toggle" bindtap="toggle" aria-label="{{visible ? '隐藏密码' : '显示密码'}}"><view class="eye-icon {{visible ? 'is-visible' : ''}}"><view class="eye-pupil"></view></view></button></view></view>
    <view class="field"><text class="label">确认新密码</text><input class="input" value="{{confirmPassword}}" data-field="confirmPassword" bindinput="input" password="true" maxlength="100" placeholder="请再次输入新密码" placeholder-class="placeholder" confirm-type="done" bindconfirm="submit" disabled="{{busy}}" /></view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button class="primary submit" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{busy ? '提交中' : '重置密码'}}</button>
    <button class="back-link" bindtap="backToLogin" disabled="{{busy}}">返回登录</button>
  </view>
  <view class="footnote">只需验证一项绑定信息，<view>即可重新开始规划。</view></view>
</view>
