<view class="page login-page">
  <view class="logo">远<view class="logo-star">✦</view></view>
  <text class="eyebrow">A NEW CHAPTER BEGINS</text>
  <view class="title">你好，未来的自己。</view><view class="subtitle">登录向远，让每一步选择都有方向。</view>
  <view class="card login-form">
    <view class="mode-tabs"><button class="{{mode === 'login' ? 'active' : ''}}" data-mode="login" bindtap="mode">登录</button><button class="{{mode === 'register' ? 'active' : ''}}" data-mode="register" bindtap="mode">注册</button><button class="{{mode === 'forgot' ? 'active' : ''}}" data-mode="forgot" bindtap="mode">找回</button></view>
    <view class="section-title">{{mode === 'register' ? '注册账号' : mode === 'forgot' ? '找回密码' : '账号登录'}}</view><view class="muted">{{mode === 'register' ? '创建账号后自动登录' : mode === 'forgot' ? '用绑定手机号或邮箱重置密码' : '使用账号密码或微信登录'}}</view>
    <view class="field"><text class="label">账号</text><input class="input" value="{{username}}" data-field="username" bindinput="input" maxlength="50" placeholder="请输入账号" placeholder-class="placeholder" disabled="{{busy}}" /></view>
    <view wx:if="{{mode === 'register'}}" class="field"><text class="label">昵称</text><input class="input" value="{{nickname}}" data-field="nickname" bindinput="input" maxlength="50" placeholder="可选" placeholder-class="placeholder" disabled="{{busy}}" /></view>
    <view wx:if="{{mode !== 'login'}}" class="field"><text class="label">手机号</text><input class="input" value="{{phone}}" data-field="phone" bindinput="input" maxlength="11" type="number" placeholder="可选，用于找回密码" placeholder-class="placeholder" disabled="{{busy}}" /></view>
    <view wx:if="{{mode !== 'login'}}" class="field"><text class="label">邮箱</text><input class="input" value="{{email}}" data-field="email" bindinput="input" maxlength="100" placeholder="可选，用于找回密码" placeholder-class="placeholder" disabled="{{busy}}" /></view>
    <view wx:if="{{mode !== 'forgot'}}" class="field"><text class="label">密码</text><view class="password-wrap"><input class="input" value="{{password}}" data-field="password" bindinput="input" password="{{!visible}}" maxlength="100" placeholder="请输入密码" placeholder-class="placeholder" confirm-type="done" bindconfirm="submit" disabled="{{busy}}" /><button class="visibility" bindtap="toggle">{{visible ? '隐藏' : '显示'}}</button></view></view>
    <view wx:else class="field"><text class="label">新密码</text><input class="input" value="{{newPassword}}" data-field="newPassword" bindinput="input" password="true" maxlength="100" placeholder="请输入新密码" placeholder-class="placeholder" confirm-type="done" bindconfirm="forgot" disabled="{{busy}}" /></view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button wx:if="{{mode !== 'forgot'}}" class="primary submit" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{busy ? '处理中' : mode === 'register' ? '注册并登录' : '登录，开启探索'}}</button>
    <button wx:else class="primary submit" bindtap="forgot" loading="{{busy}}" disabled="{{busy}}">{{busy ? '处理中' : '重置密码'}}</button>
    <button class="secondary wx-login" bindtap="wechat" loading="{{busy}}" disabled="{{busy}}">微信一键登录</button>
    <view class="help">注册后默认开通院校查询和志愿推荐。</view>
  </view>
  <view class="footnote">你的兴趣值得认真对待，<view>你的未来值得好好规划。</view></view>
</view>
