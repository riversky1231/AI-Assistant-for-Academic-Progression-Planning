.login-page { padding-top: 64rpx; }.logo { width: 110rpx; height: 110rpx; background: #244c3b; border-radius: 30rpx; color: #e6edc8; font-family: serif; font-size: 58rpx; display: flex; align-items: center; justify-content: center; position: relative; margin-bottom: 46rpx; }.logo-star { position: absolute; right: -14rpx; top: -22rpx; color: #b6bd8b; font-size: 46rpx; }.title { margin-top: 18rpx; font-size: 48rpx; }.login-form { margin-top: 46rpx; padding: 36rpx; }.login-form .muted { margin-top: 8rpx; }.mode-tabs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; margin-bottom: 28rpx; background: #edf0e7; padding: 8rpx; border-radius: 16rpx; }.mode-tabs button { background: transparent; color: #78836d; font-size: 24rpx; line-height: 64rpx; }.mode-tabs button.active { background: #ffffff; color: #244c3b; font-weight: 600; box-shadow: 0 8rpx 24rpx rgba(36, 76, 59, 0.08); }.password-wrap { position: relative; }.password-wrap .input { padding-right: 105rpx; }.visibility { position: absolute; top: 15rpx; right: 14rpx; background: transparent; color: #6c7d63; font-size: 23rpx; line-height: 60rpx; padding: 0 12rpx; }.submit { margin-top: 36rpx; }.wx-login { margin-top: 20rpx; }.help { color: #8e9588; font-size: 22rpx; margin-top: 24rpx; text-align: center; }
