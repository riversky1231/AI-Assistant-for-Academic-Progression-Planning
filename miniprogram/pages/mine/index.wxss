.account { display: flex; align-items: center; margin: 30rpx 0 36rpx; }.avatar { width: 112rpx; height: 112rpx; background: #284e3c; border-radius: 35rpx; color: #e1eab8; display: flex; align-items: center; justify-content: center; font-size: 48rpx; font-family: serif; }.account-copy { flex: 1; margin-left: 25rpx; min-width: 0; }.account-name { font-size: 35rpx; font-weight: 600; overflow-wrap: break-word; }.account .subtitle { font-size: 23rpx; margin-top: 8rpx; }.account-card { padding: 30rpx; }.compact { margin-top: 18rpx; font-size: 25rpx; line-height: 76rpx; }.profile-card { background: #edf1e5; border-color: #e0e7d4; }.profile-meta { color: #6e805e; font-size: 25rpx; }.profile-metrics { display: flex; gap: 80rpx; padding: 20rpx 0 28rpx; }.profile-metrics text { font-size: 47rpx; font-weight: 600; color: #41603b; }.profile-metrics view view { color: #8a967c; font-size: 22rpx; }.profile-empty { font-size: 25rpx; color: #839373; line-height: 1.9; padding: 10rpx 0; }.menu { padding: 0 28rpx; }.menu-row { display: flex; align-items: center; justify-content: space-between; background: transparent; border-radius: 0; padding: 28rpx 0; font-weight: 400; font-size: 27rpx; line-height: 1.8; color: #364c39; }.menu-row + .menu-row { border-top: 1rpx solid #edf0e6; }.menu-icon { display: inline-block; width: 43rpx; color: #7c8c6d; }.menu-note { font-size: 23rpx; color: #9aa18f; }.health-result { font-size: 23rpx; color: #7d8c70; padding-bottom: 22rpx; }.permission-list { display: flex; flex-wrap: wrap; gap: 14rpx; }.permission { padding: 14rpx 20rpx; border-radius: 12rpx; color: #979f8f; background: #edf0e7; font-size: 22rpx; }.permission.enabled { color: #5a774a; background: #e8eedf; }.user-list { margin-top: 12rpx; }.user-row { display: flex; justify-content: space-between; gap: 20rpx; padding: 20rpx 0; border-top: 1rpx solid #edf0e6; }.user-name { font-size: 27rpx; color: #334a38; }.user-actions { display: flex; gap: 8rpx; align-items: center; flex-shrink: 0; }.logout { margin-top: 40rpx; font-weight: 400; }
