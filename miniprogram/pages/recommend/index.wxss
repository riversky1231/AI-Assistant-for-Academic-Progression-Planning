.heading { font-size: 42rpx; margin-top: 20rpx; }.steps { display: flex; align-items: center; margin: 36rpx 0; }.step { color: #9a9e91; font-size: 24rpx; }.step text { font-size: 21rpx; margin-right: 10rpx; }.step.active { color: #3e613f; font-weight: 600; }.step-line { height: 1rpx; width: 60rpx; background: #cfd7c2; margin: 0 28rpx; }.first { margin-top: 10rpx; }.subjects { display: flex; gap: 20rpx; }.subject { flex: 1; background: #f6f7f1; border: 1rpx solid #e7ebdf; font-weight: 400; font-size: 27rpx; color: #84917a; line-height: 82rpx; border-radius: 14rpx; }.selected { background: #eaf0e2 !important; color: #385c3f !important; border-color: #8da47c !important; }.subject text { margin-left: 25rpx; }.score-row { display: flex; gap: 22rpx; }.score-row .field { flex: 1; min-width: 0; }.unit-input { position: relative; }.unit-input input { padding-right: 60rpx; }.unit-input text { position: absolute; right: 22rpx; top: 24rpx; color: #89907d; font-size: 25rpx; }.hint { font-size: 22rpx; color: #9a9e91; margin-top: 20rpx; }.preference-card { margin-top: 24rpx; }.chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }.chip { background: #f5f6ef; color: #818b74; font-size: 22rpx; font-weight: 400; padding: 0 20rpx; line-height: 56rpx; border-radius: 10rpx; border: 1rpx solid transparent; }.submit { margin-top: 28rpx; }.save { margin: 24rpx auto 0; }.notice.section { margin-top: 24rpx; }
