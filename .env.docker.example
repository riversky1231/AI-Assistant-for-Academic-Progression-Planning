# Copy to .env.docker. Set three different passwords before starting.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
REDIS_PASSWORD=

# Local access / host reverse proxy by default. Use 0.0.0.0 for direct device tests.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8080

# School queries and recommendations work without an LLM; AI chat requires these.
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
