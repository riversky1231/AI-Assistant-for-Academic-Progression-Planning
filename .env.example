# Spring Boot reads this configuration when copied to the root .env.
# Prefer setting LLM_API_KEY in the process environment; never commit secrets.
LLM_ENABLED=false
# Set the provider API base URL and model before enabling LLM.
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
# The Java Agent bounds requests to 4 model rounds and 6 tool calls in code.
